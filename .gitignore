# .NET build artifacts
bin/
obj/
*.user
tmp/

# Environment — plaintext files are never committed
# Commit the .enc equivalents instead (encrypted with SOPS + age)
.env.dev
.env.prod
!.env.dev.enc
!.env.prod.enc

# Local dev DB (docker-compose.db.yml) — a bare password for a LAN-only
# Postgres, not worth the SOPS dance; only needs to exist on the host machine
.env.db
!.env.db.example

# OS
.DS_Store
Thumbs.db

# Terraform — local provider cache and any accidental local tfvars with
# secrets. .terraform.lock.hcl IS committed (pins provider versions).
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.auto.tfvars
infra/terraform/*.auto.tfvars.json
infra/terraform/crash.log
